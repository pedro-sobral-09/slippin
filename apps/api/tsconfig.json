{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    
    "module": "nodenext",
    "target": "es2022",
    "moduleResolution": "nodenext",
    
    "types": ["node"],
    "resolveJsonModule": true,
    
    "sourceMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "skipLibCheck": true,
  },
  "include": ["src"]
}
